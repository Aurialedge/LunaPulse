# Copy to backend/.env (gitignored). Every value is optional.

# Gemini API key. Leave empty to run in fallback mode (template explanations, no network calls).
GEMINI_API_KEY=
# Gemini model (D2)
GEMINI_MODEL=gemini-3.5-flash
# SQLite database (defaults to backend/lunapulse.db)
# DATABASE_URL=sqlite:///./lunapulse.db
